# NEXORA Frontend Environment Configuration

# Backend REST API base URL (including /api)
# For local development with Vite proxy: leave blank or set to /api
# For production hosting (e.g. Vercel/Netlify pointing to Railway backend):
# VITE_API_BASE_URL=https://your-backend-app.railway.app/api
VITE_API_BASE_URL=

# Backend STOMP/WebSocket URL (including /ws)
# For local development: leave blank (auto-detects ws://localhost:8080/ws)
# For production hosting:
# VITE_WS_URL=wss://your-backend-app.railway.app/ws
VITE_WS_URL=
